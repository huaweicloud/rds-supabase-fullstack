{
  "mcpServers": {
    "rds-supabase-mgr-mcp": {
      "command": "uvx",
      "args": ["mcp-server-huaweicloud-rds-supabase-mgr"],
      "env": {
        "SUPABASE_RDS_ENDPOINT": "REPLACE_WITH_NATIVE_RDS_HTTPS_ENDPOINT",
        "HUAWEICLOUD_PROJECT_ID": "REPLACE_WITH_PROJECT_ID",
        "HUAWEICLOUD_AUTH_TOKEN": "REPLACE_WITH_SERVICE_TOKEN",
        "HUAWEICLOUD_MCP_READ_ONLY": "true",
        "SUPABASE_ENABLE_WRITES": "false"
      }
    }
  }
}
